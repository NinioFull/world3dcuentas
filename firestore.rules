rules_version = '2';
// Cola de WORLD3D Manager: solo la cuenta admin puede leer y escribir.
// Se publica en Firebase > Firestore Database > Reglas (copiar y pegar este archivo).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['world3dbo@gmail.com'];
    }
  }
}
